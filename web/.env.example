NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# service_role key: ใช้ใน API routes เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามขึ้น Git
SUPABASE_SERVICE_ROLE_KEY=ใส่ service_role key
# ทางเลือก: ถ้าตั้งค่านี้ ESP32 ต้องส่ง header x-api-key ให้ตรงกัน (ใส่ที่ API_KEY ในโค้ด ESP32)
HYDROSENSE_API_KEY=
# ทางเลือก: แจ้งเตือน LINE (Messaging API) ถ้าไม่ตั้ง token ระบบจะไม่ส่งแจ้งเตือน ดูขั้นตอนใน README.md
# ห้ามขึ้น Git และห้ามขึ้นต้นด้วย NEXT_PUBLIC_
LINE_CHANNEL_ACCESS_TOKEN=
# เว้นว่าง = ส่งหาทุกคนที่เป็นเพื่อนกับบอท / ใส่ user ID หรือ group ID = ส่งหาคนนั้นคนเดียว
LINE_TO=

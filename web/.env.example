NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# service_role key: ใช้ใน API routes เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามขึ้น Git
SUPABASE_SERVICE_ROLE_KEY=ใส่ service_role key
# ทางเลือก: ถ้าตั้งค่านี้ ESP32 ต้องส่ง header x-api-key ให้ตรงกัน (ใส่ที่ API_KEY ในโค้ด ESP32)
HYDROSENSE_API_KEY=
